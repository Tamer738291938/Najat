  shA.getRange(2, 1, ACTS.length, 7).setValues(ACTS.map(function(a){ return [a[0],a[1],a[2],a[3],a[4],a[5],a[6]]; }));
  setDropdown_(shA, "G2:G200", ["منجز","جارٍ","لم يبدأ","متأخر"]);

  /* المؤشرات — مطابقة لورقة الإكسل */
  const shK = ss.insertSheet("المؤشرات");
  shK.getRange(1, 1, 1, 13).setValues([[
    "الرمز","المؤشر","الغاية","المالك","الدورية","خط الأساس",
    "مستهدف الفصل الأول","فعلي الفصل الأول","حالة الفصل الأول",
    "مستهدف نهاية العام","فعلي نهاية العام","الحالة النهائية","ملاحظات"]]);
  shK.getRange(2, 1, KPIS.length, 13).setValues(KPIS.map(function(k){
    return [k[0],k[1],k[2],k[3],k[4],"",
            k[5]==null?"":k[5],"","",
            k[6]==null?"":k[6],"","",k[11]||""]; }));

  /* التبعيات الحرجة */
  const shD = ss.insertSheet("التبعيات الحرجة");
  shD.getRange(1, 1, 1, 6).setValues([["م","المهمة","المالك","الموعد النهائي","الحالة","ملاحظات"]]);
  shD.getRange(2, 1, DEPS.length, 6).setValues(DEPS);
  setDropdown_(shD, "E2:E100", ["منجز","جارٍ","لم يبدأ","متأخر"]);

  /* المخاطر */
  const shR = ss.insertSheet("المخاطر");
  shR.getRange(1, 1, 1, 7).setValues([["الرمز","الخطر","الدرجة","الاستجابة","المالك","الحالة","آخر مراجعة"]]);
  shR.getRange(2, 1, RISKS.length, 6).setValues(RISKS);
  setDropdown_(shR, "C2:C100", ["عالية","متوسطة","منخفضة"]);
  setDropdown_(shR, "F2:F100", ["مفتوح","تحت السيطرة","مغلق"]);

  /* المدارس */
  const shS = ss.insertSheet("المدارس");
  shS.getRange(1, 1, 1, 1).setValues([["اسم المدرسة"]]);
  shS.getRange(2, 1, SCHOOLS.length, 1).setValues(SCHOOLS.map(function(s){ return [s]; }));

  /* مدخلات المدارس — يفرّغ فيها المنسق ما يصله بالإيميل (سجل إضافة فقط) */
  const shI = ss.insertSheet("مدخلات المدارس");
  const inHead = ["التاريخ","المدرسة","الفترة"].concat(KPI_CODES).concat(["ملاحظات"]);
  shI.getRange(1, 1, 1, inHead.length).setValues([inHead]);

  /* تعليمات */
  const shT = ss.insertSheet("تعليمات", 0);
  shT.getRange(1, 1, 9, 1).setValues([
    ["نظام متابعة الخطة التشغيلية 2026-2027 — مدارس النجاة"],
    ["معرّف الجدول (SHEET_ID): " + ss.getId()],
    ["رابط الجدول: " + ss.getUrl()],
    ["خطوة إلزامية: مشاركة → أي شخص لديه الرابط → مشاهد (كي تقرأه الداشبورد)"],
    ["التحرير الموصى به عبر صفحة «تحرير البيانات» في الداشبورد (محمية بكلمة مرور)"],
    ["ويمكن التحرير هنا مباشرة أيضاً — لا تغيّر أسماء الأوراق ولا صف العناوين"],
    ["ورقة «مدخلات المدارس»: سجل إضافة فقط — كل تقرير يصل بالإيميل يُسجَّل صفاً جديداً"],
    ["الداشبورد تحتسب فعلي كل مؤشر من متوسط آخر مدخل لكل مدرسة، وإن خلت تعتمد عمود الفعلي في ورقة المؤشرات"],
    ["كلمة مرور التحرير محفوظة في خصائص السكربت — لتغييرها: شغّل دالة changePassword بعد تعديلها"]]);
  shT.getRange("A1").setFontWeight("bold").setFontSize(14);
  shT.setColumnWidth(1, 750);
  shT.setRightToLeft(true);

  [shA, shK, shD, shR, shS, shI].forEach(function(sh){
    sh.setRightToLeft(true);
    sh.getRange("1:1").setFontWeight("bold").setBackground("#E8F2F4");
    sh.setFrozenRows(1);
  });

  /* حفظ الإعدادات السرية في خصائص السكربت */
  PropertiesService.getScriptProperties().setProperties({
    SHEET_ID: ss.getId(),
    ADMIN_PASSWORD: ADMIN_PASSWORD
  });

  Logger.log("==============================================");
  Logger.log("معرّف الجدول (SHEET_ID): " + ss.getId());
  Logger.log("رابط الجدول: " + ss.getUrl());
  Logger.log("المتبقي: (1) شارك الجدول 'أي شخص لديه الرابط — مشاهد'");
  Logger.log("         (2) Deploy → New deployment → Web app → Execute as: Me · Access: Anyone");
  Logger.log("         (3) أرسل للمطوّر معرّف الجدول ورابط الـ Web app");
  Logger.log("==============================================");
}

/* لتغيير كلمة المرور لاحقاً: عدّل ADMIN_PASSWORD أعلاه ثم شغّل هذه الدالة */
function changePassword() {
  PropertiesService.getScriptProperties().setProperty("ADMIN_PASSWORD", ADMIN_PASSWORD);
  Logger.log("تم تحديث كلمة المرور");
}

/* ============================================================
 * ثانياً: نقطة الاستقبال — كل الحفظ يمر من هنا بتحقق خادمي
 * ============================================================ */
function doPost(e) {
  var out;
  try {
    var req = JSON.parse(e.postData.contents);
    var props = PropertiesService.getScriptProperties();
    if (!req.password || req.password !== props.getProperty("ADMIN_PASSWORD")) {
      out = { ok: false, error: "كلمة المرور غير صحيحة" };
    } else {
      var ss = SpreadsheetApp.openById(props.getProperty("SHEET_ID"));
      out = handle_(ss, req);
    }
  } catch (err) {
    out = { ok: false, error: String(err && err.message || err) };
  }
  return ContentService.createTextOutput(JSON.stringify(out))
    .setMimeType(ContentService.MimeType.JSON);
}

function doGet() {
  return ContentService.createTextOutput(JSON.stringify({ ok: true, service: "najat-backend" }))
    .setMimeType(ContentService.MimeType.JSON);
}

function handle_(ss, req) {
  switch (req.action) {
    case "ping":
      return { ok: true };

    /* تحديث خلايا صفوف بمفتاح العمود الأول — عام لكل الأوراق */
    case "updateRows": {
      var sh = ss.getSheetByName(req.sheet);
      if (!sh) return { ok: false, error: "الورقة غير موجودة: " + req.sheet };
      var data = sh.getDataRange().getValues();
      var head = data[0].map(String);
      var updated = 0;
      (req.rows || []).forEach(function(rw) {
        for (var r = 1; r < data.length; r++) {
          if (String(data[r][0]).trim() === String(rw.key).trim()) {
            Object.keys(rw.values).forEach(function(colName) {
              var c = head.indexOf(colName);
              if (c >= 0) sh.getRange(r + 1, c + 1).setValue(rw.values[colName]);
            });
            updated++;
            break;
          }
        }
      });
      return { ok: true, updated: updated };
    }

    /* إضافة تقرير مدرسة (سجل إضافة فقط) */
    case "addSchoolInput": {
      var shI = ss.getSheetByName("مدخلات المدارس");
      var head2 = shI.getRange(1, 1, 1, shI.getLastColumn()).getValues()[0].map(String);
      var row = head2.map(function(h) {
        if (h === "التاريخ") return new Date();
        if (h === "المدرسة") return req.school || "";
        if (h === "الفترة") return req.period || "";
        if (h === "ملاحظات") return req.notes || "";
        var v = (req.values || {})[h];
        return (v === undefined || v === null || v === "") ? "" : Number(v);
      });
      shI.appendRow(row);
      return { ok: true };
    }

    default:
      return { ok: false, error: "إجراء غير معروف: " + req.action };
  }
}

function setDropdown_(sheet, a1, values) {
  const rule = SpreadsheetApp.newDataValidation()
    .requireValueInList(values, true).setAllowInvalid(false).build();
  sheet.getRange(a1).setDataValidation(rule);
}
